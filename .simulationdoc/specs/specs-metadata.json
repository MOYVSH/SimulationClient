  "critical_decisions": [
    "坐标约定：GridPos/ChunkPos/WorldPos 定义与转换",
    "Chunk 尺寸：默认 32×32，激活窗口 3×3",
    "Entity ID：统一 int，0 表示空",
    "系统通信：优先 C# 事件，避免热路径闭包",
    "序列化：JSON + 版本号",
    "Terrain 所有权：启动时权威，运行时 WorldData 权威",
    "Tick 频率：固定频率，支持 Pause/1×/2×/4×"
  ],
  "risks": [
    "10000+ Terrain TreeInstance 运行时编辑开销",
    "100 工人同时 A* 导致 CPU 峰值",
    "Chunk 边界对象池抖动",
    "热点路径 GC 分配",
    "500+ View 导致 GPU 超标",
    "多格建筑碰撞检测错误",
    "存档版本不兼容"
  ]
